# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://medvista:medvista@localhost:5432/medvista
POSTGRES_USER=medvista
POSTGRES_PASSWORD=medvista
POSTGRES_DB=medvista

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real random secret for anything beyond local dev,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
AUTH_SECRET=INSECURE-DEV-SECRET-CHANGE-ME
ACCESS_TOKEN_EXPIRE_MINUTES=720

# DICOM server (Orthanc) — Phase 2+
DICOM_SERVER_URL=http://localhost:8042
DICOM_SERVER_USERNAME=orthanc
DICOM_SERVER_PASSWORD=orthanc

# Object storage (S3-compatible) — Phase 2+
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=medvista-imaging

# AI / LLM providers — Phase 4/6+.
# Leave blank to run with imaging AI and the clinical copilot both
# reporting themselves as unavailable (never simulated).
AI_PROVIDER=
AI_MODEL=
LLM_PROVIDER=
LLM_API_KEY=

# Feature flags
ENABLE_3D=false
ENABLE_AI=false
ENABLE_VOICE=false
ENABLE_COPILOT=false
ENABLE_RESEARCH_MODE=false
ENABLE_COLLABORATION=false

# CORS (backend) — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000
